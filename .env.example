# ==============================================================================
# ZAC 2026 LifeMate — Full Environment Configuration (ASR, LLM & Parallelism)
# ==============================================================================
# Hướng dẫn:
# - Tất cả các biến môi trường dưới đây đều là OPTIONAL (tự động nhận diện cấu hình tối ưu).
# - Bạn có thể thay đổi trực tiếp tại file này hoặc truyền qua cờ dòng lệnh (CLI).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH MODEL ASR (SPEECH-TO-TEXT) & GPU BATCHING
# ------------------------------------------------------------------------------
# Engine ASR: 'phowhisper', 'whisper', 'phoasr', 'faster_whisper'
ASR_ENGINE=phowhisper

# Tên mô hình ASR (HuggingFace ID hoặc đường dẫn checkpoint local):
# Gợi ý tối ưu cho tiếng Việt đa vùng miền (Bắc - Trung - Nam) theo luật < 1B params:
#   - 'vinai/phowhisper-large'   (~750M params - Khuyên dùng số 1: Nhận diện tốt nhất tiếng miền Trung/Nam)
#   - 'vinai/phowhisper-medium'  (~769M params - Cân bằng tốc độ và độ chính xác)
#   - 'vinai/phowhisper-small'   (~241M params - Nhẹ, nhanh)
#   - 'openai/whisper-large-v3-turbo' (~809M params - Siêu tốc, 4 decoder layers)
#   - 'Qualcomm-AI-Research/PhoASR-whisper-small' (~240M params)
ASR_MODEL_NAME_OR_PATH=vinai/phowhisper-large

# Thiết bị & kiểu dữ liệu:
DEVICE=auto
TORCH_DTYPE=float16
COMPUTE_TYPE=float16

# Tối ưu hóa xử lý LÔ (BATCHING) cho ASR trên GPU (T4 / P100 / A100):
# Gom nhiều file audio vào 1 lượt forward pass để GPU và VRAM chạy hết công suất
ASR_BATCH_SIZE=16
CHUNK_LENGTH_S=30

# Tham số giải mã Deterministic (bắt buộc theo luật ZAC 2026):
TEMPERATURE=0.0
BEAM_SIZE=1

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH HẬU XỬ LÝ ASR (POST-PROCESSING)
# ------------------------------------------------------------------------------
# Chế độ can thiệp:
#   - 'aggressive' : Can thiệp mạnh sửa lỗi phiên âm domain LifeMate (Khuyên dùng: +1.08 điểm)
#   - 'lexicon'    : Chuẩn hóa từ điển cơ bản
#   - 'off'        : Tắt hậu xử lý, dùng nguyên bản ASR thô
POSTPROC_MODE=aggressive
ENABLE_LEXICON_CORRECTION=true

# Tầng ngữ cảnh ViT5 & phục hồi dấu câu ViBERT (mở rộng):
ENABLE_CONTEXTUAL_CORRECTION=false
CONTEXT_MODEL_NAME_OR_PATH=VietAI/vit5-base
CONTEXT_BATCH_SIZE=16

ENABLE_PUNCTUATION_RESTORATION=false
PUNCTUATION_MODEL_NAME_OR_PATH=fptai/vibert-capu
PUNCTUATION_BATCH_SIZE=16

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH LLM AGENT (SERVER vLLM / NGROK / LOCAL HF)
# ------------------------------------------------------------------------------
# Chế độ chạy LLM:
#   - 'server' : Kết nối server qua API (vLLM / ngrok / Ollama) — KHUYÊN DÙNG
#   - 'hf'     : Nạp trực tiếp mô hình HuggingFace Transformers local
LLM_MODE=server

# Endpoint server (thay bằng URL ngrok hoặc local vLLM của bạn):
LLM_BASE_URL=https://5b4d-34-16-234-74.ngrok-free.app/v1
LLM_API_KEY=EMPTY

# Tên mô hình LLM (< 5B params theo quy định BTC):
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_MAX_TOKENS=512
LLM_TIMEOUT=60.0

# ------------------------------------------------------------------------------
# 4. TỐI ƯU HIỆU NĂNG: GỌI BATCH & XỬ LÝ SONG SONG (CONCURRENCY)
# ------------------------------------------------------------------------------
# Tận dụng tối đa CPU & RAM (Kaggle có 16 - 30GB RAM, đa nhân vCPU)
# và kích hoạt Continuous Batching trên vLLM server:
#   - LLM_CONCURRENCY / NUM_WORKERS = 1  : Chạy tuần tự 1 luồng (phù hợp debug từng mẫu)
#   - LLM_CONCURRENCY / NUM_WORKERS = 4  : Chạy song song 4 luồng (nhanh gấp ~3.5x)
#   - LLM_CONCURRENCY / NUM_WORKERS = 8  : Chạy song song 8 luồng (nhanh gấp ~7x, tận dụng full RAM/vLLM)
#   - LLM_CONCURRENCY / NUM_WORKERS = 16 : Tối đa hóa throughput cho bài thi
LLM_CONCURRENCY=8
NUM_WORKERS=8

# Bật tính năng gom lô trước toàn bộ âm thanh ASR bằng GPU (Batch ASR):
BATCH_ASR=true

# Luồng kiểm thử trong compare_asr_postproc_llm:
#   - 'all'          : Chạy cả 3 luồng (ASR Raw, ASR + PostProc, Gold Text) để đối chiếu toàn diện
#   - 'postproc'     : Chỉ chạy luồng ASR + PostProc (nhanh nhất, tiết kiệm 66% thời gian gọi LLM)
#   - 'postproc_gold': Chạy luồng PostProc và Gold (đối chứng trần điểm)
#   - 'raw'          : Chỉ chạy luồng Raw ASR
EVAL_STREAMS=all

# ------------------------------------------------------------------------------
# 5. ĐƯỜNG DẪN DỮ LIỆU (DATA PATHS)
# ------------------------------------------------------------------------------
# Kaggle path: /kaggle/input/datasets/n107hoangtuong/zalo-competion/train+public_test
# Local path: D:/Download/train+public_test/train+public_test
DATA_ROOT=/kaggle/input/datasets/n107hoangtuong/zalo-competion/train+public_test
OUTPUT_DIR=data/MultiASR_Results
BENCHMARK_FILE=data/val_benchmark_200.jsonl
