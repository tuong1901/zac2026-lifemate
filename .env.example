# ==============================================================================
# ZAC 2026 LifeMate — ASR & Post-Processing Environment Configuration
# ==============================================================================

# 1. Cấu hình Model ASR
# Lựa chọn engine: 'phowhisper', 'phoasr', 'faster_whisper'
ASR_ENGINE=phowhisper

# Tên mô hình HuggingFace hoặc đường dẫn thư mục checkpoint local:
# Gợi ý:
#   - 'vinai/phowhisper-small'   (~241M params)
#   - 'vinai/phowhisper-medium'  (~769M params - Khuyên dùng)
#   - 'vinai/phoasr-base'        (~95M params CTC siêu tốc)
#   - 'openai/whisper-large-v3-turbo' (~809M params)
ASR_MODEL_NAME_OR_PATH=vinai/phowhisper-medium

# Thiết bị & kiểu dữ liệu GPU: 'cuda', 'cpu', 'auto'
DEVICE=auto
TORCH_DTYPE=float16
COMPUTE_TYPE=float16

# 2. Tối ưu xử lý theo Lô (Batching) trên Kaggle GPU (T4 / P100 / A100)
# Tăng batch_size lên 16 hoặc 32 để GPU đạt tốc độ tối đa
ASR_BATCH_SIZE=16
NUM_WORKERS=2
CHUNK_LENGTH_S=30

# 3. Tham số giải mã Deterministic (theo điều lệ ZAC 2026)
TEMPERATURE=0.0
BEAM_SIZE=1

# 4. HẬU XỬ LÝ (POST-PROCESSING) 3 TẦNG:
# Tầng 1: Từ điển nghiệp vụ & Chuẩn hóa Rule-based (Smart Home, Zalo, Banking, TV...)
ENABLE_LEXICON_CORRECTION=true

# Tầng 2: Sửa lỗi ngữ cảnh (ViT5 Contextual Correction)
ENABLE_CONTEXTUAL_CORRECTION=false
CONTEXT_MODEL_NAME_OR_PATH=VietAI/vit5-base
CONTEXT_BATCH_SIZE=16

# Tầng 3: Phục hồi dấu câu & Viết hoa (ViBERT-capu Punctuation Restoration)
ENABLE_PUNCTUATION_RESTORATION=false
PUNCTUATION_MODEL_NAME_OR_PATH=fptai/vibert-capu
PUNCTUATION_BATCH_SIZE=16

# 5. Đường dẫn Dữ liệu (Local & Kaggle)
# Local: D:/Download/train+public_test/train+public_test
# Kaggle: /kaggle/input/zalo-ai-challenge-2026/train+public_test
DATA_ROOT=D:/Download/train+public_test/train+public_test
OUTPUT_DIR=data/MultiASR_Results
BENCHMARK_FILE=data/val_benchmark_200.jsonl

