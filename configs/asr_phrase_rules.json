  {"id":"translate_phrase","pattern":"(?:^|[.!?]\\s*)(?P<bad>lịch)(?=\\s+sang\\s+tiếng\\b)","replacement":"dịch","apps":["translator"],"context_pattern":"\\bcâu này\\b"},
  {"id":"translate_done","pattern":"\\b(?P<bad>lịch)(?=\\s+xong\\s+thì\\s+lưu\\b)","replacement":"dịch","apps":["translator"],"context_pattern":"\\bdịch sang tiếng\\b"}
