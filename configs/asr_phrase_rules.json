  {"id":"invoice_due","pattern":"\\b(?P<bad>khoá đơn|khóa đơn)\\b(?=\\s+(?:nước|điện|mạng|truyền hình)\\s+(?:sắp|tới|đến|tháng)\\b)","replacement":"hóa đơn","apps":["bill_payment"],"block_before":"\\b(?:đừng|không|hãy|muốn|cần)\\s*$"},
