  {"id":"invoice_status","pattern":"\\bđã có (?P<bad>khoá đang|khóa đang)(?=\\s+chưa\\b)","replacement":"hóa đơn","apps":["bill_payment"],"context_pattern":"\\b(?:học phí|tiền|thanh toán|trả)\\b"},
  {"id":"price_alert","pattern":"\\b(?:đặt|tạo|bật)\\s+(?P<bad>cạnh bao)(?=\\s+giá\\b)","replacement":"cảnh báo","apps":["stocks"]},
  {"id":"shopping_list","pattern":"\\b(?P<bad>danh sách đi chờ|danh sách đi trả)\\b(?!\\s+(?:hàng|tiền|nợ)\\b)","replacement":"danh sách đi chợ","apps":["shopping_list"],"context_pattern":"\\b(?:thêm|cho|đưa|vào|mở)\\b"},
  {"id":"repair_shop","pattern":"\\b(?P<bad>tiệm sữa xe)\\b","replacement":"tiệm sửa xe","apps":["maps"],"context_pattern":"\\b(?:tìm|quanh|gần|đường)\\b"},
